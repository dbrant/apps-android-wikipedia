<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/contentsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/topImage"
                style="@style/ImageViewDefault"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="16dp"
                android:layout_marginVertical="16dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/descriptionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:textColor="?attr/primary_color"
                tools:text="Lorem ipsum" />

            <LinearLayout
                android:id="@+id/donateGooglePayButton"
                style="@style/SideDrawerMenuItem">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    app:srcCompat="@drawable/ic_heart_24"
                    app:tint="?attr/progressive_color" />

                <TextView
                    style="@android:style/TextAppearance"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_weight="1"
                    android:textColor="?attr/progressive_color"
                    android:fontFamily="sans-serif-medium"
                    android:text="Donate with Google Pay" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/donateOtherButton"
                style="@style/SideDrawerMenuItem">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    app:srcCompat="@drawable/ic_open_in_new_black_24px" />

                <TextView
                    style="@android:style/TextAppearance"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_weight="1"
                    android:text="Other payment method" />
            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />

    <View
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_marginVertical="8dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/rounded_2dp_fill"/>

</FrameLayout>
